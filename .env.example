# Example configuration for cmd/asana. Copy it to .env and fill in real values:
#
#   cp .env.example .env
#
# Real environment variables take precedence over values in this file.

# Required. Asana personal access token, created under
# My Profile > Apps > Developer apps > Personal access tokens:
# https://developers.asana.com/docs/personal-access-token
ASANA_PERSONAL_ACCESS_TOKEN=1/0000000000000000:00000000000000000000000000000000
